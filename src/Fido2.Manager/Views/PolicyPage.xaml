<UserControl
    x:Class="Fido2.Manager.Views.PolicyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
        <TextBlock Text="{x:Bind ViewModel.StateText, Mode=OneWay}" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="8">
                <TextBlock x:Name="AlwaysUvTitle" FontSize="16" FontWeight="SemiBold" />
                <TextBlock x:Name="AlwaysUvDesc"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="{x:Bind ViewModel.ToggleButtonText, Mode=OneWay}"
                            Command="{x:Bind ViewModel.ToggleAlwaysUvCommand}"
                            IsEnabled="{x:Bind ViewModel.CanToggleAlwaysUv, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.AlwaysUvText, Mode=OneWay}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="8">
                <TextBlock x:Name="MinPinTitle" FontSize="16" FontWeight="SemiBold" />
                <TextBlock x:Name="MinPinDesc"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <NumberBox Value="{x:Bind ViewModel.MinPinLength, Mode=TwoWay}"
                               Minimum="4" Maximum="63" SpinButtonPlacementMode="Compact" Width="140" />
                    <Button x:Name="ApplyMinPinButton" Command="{x:Bind ViewModel.ApplyMinPinCommand}"
                            IsEnabled="{x:Bind ViewModel.CanSetMinPin, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="8">
                <TextBlock x:Name="ForceChangeTitle" FontSize="16" FontWeight="SemiBold" />
                <TextBlock x:Name="ForceChangeDesc"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="ForceChangeButton" Command="{x:Bind ViewModel.ForcePinChangeCommand}"
                        IsEnabled="{x:Bind ViewModel.CanSetMinPin, Mode=OneWay}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
