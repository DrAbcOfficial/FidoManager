<UserControl
    x:Class="Fido2.Manager.Views.PinPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto">
        <StackPanel Spacing="14" MaxWidth="560" HorizontalAlignment="Left">

            <!-- 状态 + 检查 -->
            <Border Style="{StaticResource Card}" MinWidth="460">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE72E;" FontSize="16"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StateText, Mode=OneWay}"
                               Style="{StaticResource PageCaption}" VerticalAlignment="Center" />
                    <Button Grid.Column="2" x:Name="CheckButton" Style="{StaticResource ToolButton}"
                            Command="{x:Bind ViewModel.CheckCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock x:Name="CheckButtonText" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 修改 PIN -->
            <Border Style="{StaticResource Card}" MinWidth="460">
                <StackPanel Spacing="14">
                    <PasswordBox x:Name="OldPinBox" PasswordRevealMode="Peek"
                                 Password="{x:Bind ViewModel.OldPin, Mode=TwoWay}"
                                 IsEnabled="{x:Bind ViewModel.HasPin, Mode=OneWay}" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="NewPinBox" PasswordRevealMode="Peek"
                                     Password="{x:Bind ViewModel.NewPin, Mode=TwoWay}" />
                        <PasswordBox x:Name="ConfirmPinBox" Grid.Column="1" PasswordRevealMode="Peek"
                                     Password="{x:Bind ViewModel.ConfirmPin, Mode=TwoWay}" />
                    </Grid>

                    <Button x:Name="ApplyButton" HorizontalAlignment="Left"
                            Style="{StaticResource PrimaryToolButton}"
                            Command="{x:Bind ViewModel.ApplyCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE73E;" FontSize="14" />
                            <TextBlock x:Name="ApplyButtonText" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
