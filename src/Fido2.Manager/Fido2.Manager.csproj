<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Fido2.Manager</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 非打包应用的任务栏/Alt-Tab/窗口图标取自 exe 内嵌图标,由 tools/make_icons.py 生成 -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>

    <!-- WinUI 3 -->
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <DefaultLanguage>en-US</DefaultLanguage>

    <!-- 非打包(免 MSIX)部署 -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <!-- NativeAOT + 单文件自包含发布(Windows App SDK 1.6+) -->
    <PublishAot>true</PublishAot>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <TrimMode>full</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows App SDK 2.x:正式支持 .NET 10 + NativeAOT 的 WinUI 3 -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <!-- 8.4.2 起分部属性生成不再要求 LangVersion=preview(.NET 10 默认语言版本可用) -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fido2.Core\Fido2.Core.csproj" />
  </ItemGroup>

  <!-- 双语 UI 字符串: Strings\zh-Hans / Strings\en-US 的 *.resw 由 SDK 自动包含进 PRI,
       运行时由 MRT Core 原生解析,NativeAOT 下照常工作 -->

</Project>
