<Window
    x:Class="Fido2.Manager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:views="using:Fido2.Manager.Views"
    xmlns:services="using:Fido2.Manager.Services"
    xmlns:local="using:Fido2.Manager">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 提权横幅 -->
        <Border x:Name="Banner" Background="#FCF8E3" Padding="12,8">
            <TextBlock x:Name="BannerText" Foreground="#8A6D3B" TextWrapping="Wrap" />
        </Border>

        <!-- 设备选择行 + 语言切换 -->
        <Grid Grid.Row="1" Padding="12,8" ColumnSpacing="8"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="DeviceLabel" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{x:Bind ViewModel.Devices}"
                      SelectedItem="{x:Bind ViewModel.SelectedDevice, Mode=TwoWay}"
                      HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="services:DeviceEntry">
                        <TextBlock Text="{x:Bind DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <muxc:ProgressRing Grid.Column="2" Width="22" Height="22"
                               x:Name="BusyRing" IsActive="False" />
            <Button Grid.Column="3" x:Name="RefreshButton" Command="{x:Bind ViewModel.RefreshCommand}"
                    Style="{ThemeResource AccentButtonStyle}" />
            <TextBlock Grid.Column="4" x:Name="LanguageLabel" VerticalAlignment="Center" />
            <ComboBox Grid.Column="5" x:Name="LanguageCombo" Width="160"
                      SelectionChanged="LanguageCombo_SelectionChanged"
                      VerticalAlignment="Center">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="local:LanguageOption">
                        <TextBlock Text="{x:Bind Label}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <!-- 功能页 -->
        <muxc:NavigationView Grid.Row="2" x:Name="Nav"
                             PaneDisplayMode="Top"
                             IsBackButtonVisible="Collapsed"
                             IsSettingsVisible="False"
                             SelectionChanged="Nav_SelectionChanged">
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem x:Name="NavDeviceInfo" Tag="0" IsSelected="True" />
                <muxc:NavigationViewItem x:Name="NavCredentials" Tag="1" />
                <muxc:NavigationViewItem x:Name="NavFingerprints" Tag="2" />
                <muxc:NavigationViewItem x:Name="NavPin" Tag="3" />
                <muxc:NavigationViewItem x:Name="NavPolicy" Tag="4" />
                <muxc:NavigationViewItem x:Name="NavReset" Tag="5" />
            </muxc:NavigationView.MenuItems>

            <Grid Padding="16,12">
                <views:DeviceInfoPage x:Name="Page0" />
                <views:CredentialsPage x:Name="Page1" Visibility="Collapsed" />
                <views:FingerprintsPage x:Name="Page2" Visibility="Collapsed" />
                <views:PinPage x:Name="Page3" Visibility="Collapsed" />
                <views:PolicyPage x:Name="Page4" Visibility="Collapsed" />
                <views:ResetPage x:Name="Page5" Visibility="Collapsed" />
            </Grid>
        </muxc:NavigationView>

        <!-- 状态条 -->
        <Border Grid.Row="3" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="12,4">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Border>
    </Grid>
</Window>
