# Build results
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# Python tooling artifacts (tools/*.py)
__pycache__/
*.pyc

# Visual Studio / Rider / VS Code
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates

# NativeAOT / single-file publish output (bin covers it; kept explicit for clarity)
publish/

# MSBuild binary logs
*.binlog
*.binlog.*

# NuGet
*.nupkg
**/packages/*
!**/packages/build/
*.nuget.props
*.nuget.targets
project.lock.json

# Windows App SDK / MSIX tooling intermediate
*.appx
*.msix
*.appxbundle
*.msixupload
AppPackages/

# XAML compiler intermediates are under obj/ (covered above); keep sources only.

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# OS cruft
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.DS_Store
